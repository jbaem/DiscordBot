# 디스코드 봇 토큰 (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# 봇 애플리케이션 ID (Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# 개발/테스트용 길드(서버) ID (선택 사항)
# - 비워두면(권장): 봇이 참여한 모든 서버에 전역 명령어로 등록 (새 서버 반영에 몇 분 소요)
# - 값을 넣으면: 해당 서버 한 곳에만 즉시 등록되고 다른 서버에는 명령어가 보이지 않음 (개발 중에만 사용)
GUILD_ID=

# [기능 1] Join-to-Create 임시 음성 방 생성용 트리거 채널 ID
# (이 음성 채널에 접속하면 자동으로 개인 음성 채널이 생성되고 이동됩니다)
JOIN_TO_CREATE_CHANNEL_ID=

# [기능 2] 입장 및 퇴장 알림 채널 ID
WELCOME_CHANNEL_ID=
LEAVE_CHANNEL_ID=

# [기능 3] 신규 멤버 자동 지급 역할 ID (선택 사항)
# 서버에서 /자동역할 명령어로 설정하면 이 값보다 우선합니다.
AUTO_ROLE_ID=

# [기능 4] 봇 프로필 말풍선(커스텀 상태) 문구 (선택 사항, 비우면 기본 문구 사용)
BOT_STATUS=

# [기능 5] 채널 자동 백업용 비공개 채널 ID (선택 사항, 여러 서버는 쉼표로 구분)
# 1시간마다·종료 시 백업 파일을 이 채널에 올리고, 디스크 데이터가 지워진 채로 시작하면 여기서 불러옵니다.
# 디스호스트처럼 재배포 때 data/ 가 지워질 수 있는 호스팅에서는 호스팅 패널 환경 변수에 넣으세요.
BACKUP_CHANNEL_ID=
